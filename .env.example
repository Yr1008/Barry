# ============================================
# BARRY — AI Assistant Configuration
# Copy this to .env and fill in your values
# ============================================

# ---- Claude API ----
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---- Barry Settings ----
BARRY_NAME=Barry
BARRY_OWNER_NAME=Your Name
BARRY_TIMEZONE=America/New_York
BARRY_POLL_INTERVAL_MINUTES=5
BARRY_BRIEFING_TIME=07:30
BARRY_DATA_DIR=./data

# ---- Google Calendar / Gmail ----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# After OAuth, token will be saved to data/google_token.json

# ---- Apple Calendar (CalDAV / iCloud) ----
ICLOUD_EMAIL=your_apple_id@icloud.com
ICLOUD_PASSWORD=your_app_specific_password
# Generate app-specific password at appleid.apple.com

# ---- Email (IMAP/SMTP) ----
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# How many recent emails to check
EMAIL_SCAN_COUNT=50

# ---- WhatsApp (Twilio) ----
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Your WhatsApp number (with country code)
MY_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX

# ---- iPhone / Mac Shortcuts Webhook ----
# Barry will receive data from Apple Shortcuts on this endpoint
SHORTCUTS_WEBHOOK_SECRET=generate_a_random_secret_here
SHORTCUTS_WEBHOOK_PORT=8001

# ---- Reminders / Notes (Apple) ----
# These come via Shortcuts webhook — no extra config needed

# ---- FastAPI Server ----
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=generate_a_random_secret_here

# ---- Notifications ----
# Pushover for mobile notifications (optional)
PUSHOVER_USER_KEY=your_pushover_user_key
PUSHOVER_API_TOKEN=your_pushover_api_token

# ---- Calendly (via MCP connector) ----
CALENDLY_API_KEY=your_calendly_api_key

# ---- Fireflies (meeting transcripts) ----
FIREFLIES_API_KEY=your_fireflies_api_key

# ---- Debug ----
DEBUG=false
LOG_LEVEL=INFO
